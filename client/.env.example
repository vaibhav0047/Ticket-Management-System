# Backend API Endpoint URL
# For single-server deployment (Render/Railway), leave empty or set to '/api'
# For separate Vercel frontend + Render backend deployment, set to 'https://your-backend-api.onrender.com/api'
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (matching backend)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
